PORTAL_SESSION_SECRET=gere-uma-chave-longa-e-aleatoria
# Opcional: separa a pseudonimização dos telefones da chave de sessão.
# Se omitida, o Portal usa PORTAL_SESSION_SECRET como fallback server-side.
PORTAL_IDENTITY_HMAC_SECRET=gere-outra-chave-longa-e-aleatoria
PORTAL_SECURE_COOKIE=0
# Integrações server-side: 1 retry adicional apenas para operações seguras.
PORTAL_HTTP_TIMEOUT=5
PORTAL_HTTP_RETRIES=1
PORTAL_HTTP_RETRY_BACKOFF=0.2

# APIs já executadas pelo deploy/chatbot-standalone.
ESTOQUE_API_URL=http://host.docker.internal:8100
ESTOQUE_API_TOKEN=cole-a-credencial-da-loja
CHATBOT_API_URL=http://host.docker.internal:8001
CHATBOT_API_TOKEN=cole-a-credencial-da-loja
# Motor de simulação (credenciais bancárias por loja — ver README, armadilha dos tokens).
MOTOR_URL=http://host.docker.internal:8002
MOTOR_TOKEN=cole-a-credencial-global-so-para-deploy-de-uma-loja
# Multi-loja: {"slug-da-loja": "token-do-cliente-motor-da-loja"}. Sem o slug no mapa,
# a loja fica sem acesso (nunca cai no global). Tokens se emitem no motor-simulacao:
# python -m app.cli criar-cliente --nome <loja> | criar-credencial --cliente-id <id> --nome <loja>
MOTOR_TOKENS_JSON={"slug-da-loja": "cole-o-token-do-cliente-motor-da-loja"}
