# Copie para .env se quiser trocar a senha do Postgres (opcional; default "estoque").
POSTGRES_PASSWORD=estoque

# Outbox: chave Fernet para cifrar o segredo HMAC do webhook em repouso.
# Gere com: docker compose run --rm estoque-api python -m app.cli gerar-chave-outbox
# Só é exigida quando existir um destino de webhook configurado.
ESTOQUE_OUTBOX_KEY=
# Intervalo (segundos) do worker de entrega da outbox.
ESTOQUE_OUTBOX_INTERVALO=5
