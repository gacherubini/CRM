ESTOQUE_PUBLIC_API_URL=http://host.docker.internal:8100
ESTOQUE_PUBLIC_API_TOKEN=
CATALOGO_PORT=8200
CATALOGO_PUBLIC_BASE_URL=http://localhost:8200
CATALOGO_PAGE_SIZE=12
CATALOGO_SECURE_COOKIE=0

# --- Funil Catálogo -> Chatbot (opcional) ---
# Vazio => NÃO envia nada: os cliques ficam só no volume local (catalogo_data).
# Para ligar o funil, aponte para a ingestão do Chatbot e informe um token de serviço da loja:
#   CATALOGO_EVENTS_URL=http://host.docker.internal:8001/v1/integracoes/catalogo/interesses
#   CATALOGO_EVENTS_TOKEN=<token de serviço da loja no Chatbot>
# O outbox entrega catalog.interest_clicked com Authorization: Bearer <token>,
# Idempotency-Key = event_id e X-Event-Type. Reentregas são idempotentes.
CATALOGO_EVENTS_URL=
CATALOGO_EVENTS_TOKEN=
CATALOGO_EVENTS_TIMEOUT=5
CATALOGO_EVENTS_MAX_ATTEMPTS=5
CATALOGO_EVENTS_WORKER_INTERVAL=5
