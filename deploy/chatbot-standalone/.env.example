# Copie para .env e preencha.

# Senha do Postgres compartilhado pelos serviços (opcional; default "crm").
POSTGRES_PASSWORD=crm

# Chave da API da Evolution (invente uma string secreta; usada no header apikey).
EVOLUTION_API_KEY=troque-por-uma-chave-secreta

# Chave de criptografia do n8n (invente uma string).
N8N_ENCRYPTION_KEY=troque-por-outra-chave-secreta

# Simulação: mock (demo, sem Motor) | http (Motor real) | none (só atendimento)
SIMULATION_PROVIDER=mock
# Se SIMULATION_PROVIDER=http, aponte para o Motor:
# MOTOR_URL=http://host.docker.internal:8000

# A chave do Gemini NÃO vai aqui — ela é cadastrada como credencial no n8n (UI).
