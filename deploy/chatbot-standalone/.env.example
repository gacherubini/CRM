# Copie para .env e preencha.

# Senha do Postgres compartilhado pelos serviços (opcional; default "crm").
POSTGRES_PASSWORD=crm

# Chave da API da Evolution (invente uma string secreta; usada no header apikey).
EVOLUTION_API_KEY=troque-por-uma-chave-secreta

# Chave de criptografia do n8n (invente uma string).
N8N_ENCRYPTION_KEY=troque-por-outra-chave-secreta

# Segredo compartilhado entre os dois nós webhook do n8n e a Chatbot API.
# Gere uma string forte e substitua __CHATBOT_WEBHOOK_TOKEN__ pelo mesmo valor no workflow.
CHATBOT_WEBHOOK_TOKEN=troque-por-um-segredo-forte
# Proteções do webhook (defaults recomendados; rate limit é por processo/origem).
CHATBOT_WEBHOOK_MAX_PAYLOAD_BYTES=32768
CHATBOT_WEBHOOK_MAX_TEXT_CHARS=4096
CHATBOT_WEBHOOK_MAX_INSTANCE_CHARS=120
CHATBOT_WEBHOOK_MAX_PROVIDER_MESSAGE_ID_CHARS=255
CHATBOT_WEBHOOK_MAX_EVENT_TYPE_CHARS=64
CHATBOT_WEBHOOK_RATE_LIMIT_REQUESTS=600
CHATBOT_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
CHATBOT_WEBHOOK_RATE_LIMIT_MAX_BUCKETS=10000

# Simulação: mock (demo, sem Motor) | http (Motor real) | none (só atendimento)
SIMULATION_PROVIDER=mock
# Se SIMULATION_PROVIDER=http, aponte para o Motor:
MOTOR_URL=
# Credencial criada no Motor com `python -m app.cli criar-credencial`.
MOTOR_TOKEN=
MOTOR_REQUEST_TIMEOUT=5
MOTOR_POLL_TIMEOUT=20
MOTOR_POLL_INTERVAL=0.5

# Estoque — busca pública (catálogo) e lookup privado por placa (CRM WhatsApp).
# Público: listagem /public/v1/lojas/{slug}/veiculos
ESTOQUE_PUBLIC_URL=http://estoque-api:8000
# Privado: GET /v1/veiculos/por-placa/{placa} com Bearer da loja
# (mesma credencial de serviço do Estoque: python -m app.cli criar-credencial).
ESTOQUE_API_URL=http://estoque-api:8000
ESTOQUE_API_TOKEN=

# A chave do Gemini NÃO vai aqui — ela é cadastrada como credencial no n8n (UI).

# Outbox do Estoque (entrega de eventos vehicle.* via webhook assinado).
# Gere com: docker compose run --rm estoque-api python -m app.cli gerar-chave-outbox
# Necessária só quando você configurar um destino de webhook para alguma loja.
ESTOQUE_OUTBOX_KEY=
# Intervalo (segundos) do worker de entrega.
ESTOQUE_OUTBOX_INTERVALO=5
