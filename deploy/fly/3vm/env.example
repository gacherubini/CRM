# Secrets / env da VM app (app2037) — NÃO commitar valores reais.
# fly secrets set KEY=value -a app2037

# --- Postgres (suite-pg) — um DB por serviço ---
CHATBOT_DATABASE_URL=postgresql://USER:PASS@suite-pg.flycast:5432/chatbot
ESTOQUE_DATABASE_URL=postgresql://USER:PASS@suite-pg.flycast:5432/estoque
MOTOR_DATABASE_URL=postgresql://USER:PASS@suite-pg.flycast:5432/motor

# Portal (sqlite no volume /data)
PORTAL_DATABASE_URL=sqlite:////data/portal/portal.db
PORTAL_SESSION_SECRET=
PORTAL_IDENTITY_HMAC_SECRET=
PORTAL_ENCRYPTION_KEY=
# Retry automático do outbox CAPI (defaults abaixo).
# PORTAL_CAPI_RETRY_ENABLED=1
# PORTAL_CAPI_RETRY_INTERVAL_SECONDS=60
# PORTAL_CAPI_RETRY_INITIAL_DELAY_SECONDS=30
# PORTAL_CAPI_RETRY_MAX_ATTEMPTS=8
# PORTAL_CAPI_RETRY_BACKOFF_BASE_SECONDS=60

# Tokens entre serviços
CHATBOT_WEBHOOK_TOKEN=
CHATBOT_API_TOKEN=
# Opcional no bundle app2037: se vazio, o Catálogo reutiliza CHATBOT_API_TOKEN.
# Em deploy separado, prefira uma credencial tenant-scoped exclusiva.
CATALOGO_EVENTS_TOKEN=
# Opcional: slug equivalente no Portal quando difere do slug público do Catálogo.
CATALOGO_PORTAL_STORE_SLUG=
ESTOQUE_API_TOKEN=
ESTOQUE_PUBLIC_API_TOKEN=
ESTOQUE_OUTBOX_KEY=
MOTOR_TOKEN=
MOTOR_METRICS_TOKEN=
MOTOR_ENCRYPTION_KEY=

# Evolution (VM canal)
CHATBOT_AUDIO_EVOLUTION_API_KEY=
CHATBOT_IMAGE_EVOLUTION_API_KEY=
# URL já default no fly.app.toml: http://evolution2037.flycast:8080

# n8n
N8N_ENCRYPTION_KEY=
# Gemini fica DENTRO do n8n (UI), não como secret Fly

# --- Fan-out Playwright (motor-api em app2037 → Machines API em motor2037) ---
# Obrigatório no app2037 para acordar workers on-demand.
MOTOR_FANOUT_ENABLED=1
MOTOR_FLY_AUTOSCALE_ENABLED=1
FLY_APP_NAME=motor2037
# Token app-scoped com permissão de start/stop no app motor2037 (não token pessoal).
FLY_API_TOKEN=
# Opcional (defaults no código / fly.app.toml):
# MOTOR_MAX_BROWSER_WORKERS=2
# MOTOR_FLY_START_BURST=2
# MOTOR_WORKER_IDLE_STOP_SECONDS=60
# MOTOR_WORKER_REWAKE_SECONDS=90

# Evolution app secrets (evolution2037)
# DATABASE_CONNECTION_URI=postgresql://...@suite-pg.flycast:5432/evolution
# AUTHENTICATION_API_KEY=
# CACHE_REDIS_URI=

# =============================================================================
# motor2037 — workers Playwright only (fly.worker.toml)
# fly secrets set ... -a motor2037
# =============================================================================
# DATABASE_URL = mesmo DB motor que MOTOR_DATABASE_URL no app2037
# DATABASE_URL=postgresql://USER:PASS@suite-pg.flycast:5432/motor
# MOTOR_ENCRYPTION_KEY=   # mesmo valor do app2037
# MOTOR_METRICS_TOKEN=    # opcional
#
# NÃO colocar FLY_API_TOKEN no worker (orquestrador é o app2037).
# MOTOR_WORKER_PROVEDOR é por Machine (slot), não secret global do app.
# Demais flags de browser/on-demand vêm de deploy/fly/3vm/fly.worker.toml [env].
