# Secrets / env da VM app (app2037) — NÃO commitar valores reais.
# fly secrets set KEY=value -a app2037

# --- Postgres (suite-pg) — um DB por serviço ---
CHATBOT_DATABASE_URL=postgresql://USER:PASS@suite-pg.flycast:5432/chatbot
ESTOQUE_DATABASE_URL=postgresql://USER:PASS@suite-pg.flycast:5432/estoque
MOTOR_DATABASE_URL=postgresql://USER:PASS@suite-pg.flycast:5432/motor

# Portal (sqlite no volume /data)
PORTAL_DATABASE_URL=sqlite:////data/portal/portal.db
PORTAL_SESSION_SECRET=
PORTAL_IDENTITY_HMAC_SECRET=
PORTAL_ENCRYPTION_KEY=

# Revy Tráfego (banco próprio; UI https://app2037.fly.dev/trafego)
REVY_TRAFEGO_DATABASE_URL=sqlite:////data/revy-trafego/revy_trafego.db
REVY_TRAFEGO_SESSION_SECRET=
REVY_TRAFEGO_SERVICE_TOKEN=
REVY_TRAFEGO_BOOTSTRAP_EMAIL=trafego@revy.local
REVY_TRAFEGO_BOOTSTRAP_SENHA=
# Revy Control: convite de gestor por e-mail (console por padrão; SMTP em produção)
# REVY_TRAFEGO_EMAIL_BACKEND=console
# REVY_TRAFEGO_EMAIL_FROM=no-reply@seu-dominio.com
# REVY_TRAFEGO_EMAIL_FROM_NAME=Revy Control
# REVY_TRAFEGO_PUBLIC_BASE_URL=https://app2037.fly.dev
# REVY_TRAFEGO_SMTP_HOST=
# REVY_TRAFEGO_SMTP_PORT=587
# REVY_TRAFEGO_SMTP_USERNAME=
# REVY_TRAFEGO_SMTP_PASSWORD=
# REVY_TRAFEGO_SMTP_USE_TLS=1
# Cutover completo (lab 2026-07-28+): API + workers no Revy Tráfego
# PORTAL_REVY_TRAFEGO_RESULTADOS=1
# PORTAL_REVY_TRAFEGO_VENDA_EVENTS=1
# PORTAL_CAPI_RETRY_ENABLED=0
# PORTAL_META_SPEND_SYNC_ENABLED=0
# REVY_TRAFEGO_CAPI_WORKER=1
# REVY_TRAFEGO_META_SPEND_SYNC_ENABLED=1
# Gates futuros do Revy Control; manter desligados até o rollout de cada fase.
# GOOGLE_ADS_SYNC_ENABLED=0
# GOOGLE_CONVERSIONS_ENABLED=0
# MULTI_WHATSAPP_ENABLED=0
# REVY_CONTROL_DASHBOARD_ENABLED=0
# Provider de conexão de canal: stub (default) | evolution (real)
# CHATBOT_WHATSAPP_PROVIDER=stub
# Webhook n8n gravado em instância Evolution nova (um workflow serve N números)
# CHATBOT_EVOLUTION_WEBHOOK_URL=https://n8n2037.fly.dev/webhook/whatsapp-ai
# Tela de números de WhatsApp na Loja (Ajustes)
# REVY_LOJA_WHATSAPP_ENABLED=0
#
# --- Google Ads OAuth (Revy Control) — secrets; nunca commitar valores reais ---
# Sem estes três, conectar Google Ads falha com GoogleAdsOAuthMisconfigured.
# GOOGLE_ADS_OAUTH_CLIENT_ID=
# GOOGLE_ADS_OAUTH_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# PASSO MANUAL DE OPS AINDA NÃO FEITO: a Parte B de
# docs/superpowers/specs/2026-07-29-telas-canais-wa-google-design.md acrescenta a rota HTML
# GET /app/control/google-ads/oauth/callback (redireciona para o detalhe da loja). Antes de
# operar OAuth pela UI é obrigatório (1) registrar essa URL como "URI de redirecionamento
# autorizado" no Google Cloud Console e (2) apontar GOOGLE_ADS_OAUTH_REDIRECT_URI para ela.
# O endpoint JSON /control/v1/google-ads/oauth/callback permanece para compatibilidade, mas
# se Console e env continuarem apontando para ele o admin volta do Google e vê JSON cru —
# falha silenciosa, sem erro no log. No lab, lembrar do prefixo /trafego do edge.
# GOOGLE_ADS_OAUTH_REDIRECT_URI=https://app2037.fly.dev/trafego/app/control/google-ads/oauth/callback
#
# --- Projeção operacional (runbook docs/plans/2026-07-29-runbook-rollout-lab-provisionamento.md) ---
# 1) Deploy main (alembic cria tabelas). 2) Tokens por destino. 3) Só então delivery=1.
# REVY_CONTROL_ENABLED=0
# REVY_CONTROL_RBAC_ENABLED=0
# REVY_CONTROL_PROVISIONING_DELIVERY_ENABLED=0
# REVY_CONTROL_PROVISIONING_INTERVAL_SECONDS=30
# REVY_CONTROL_PROVISIONING_INITIAL_DELAY_SECONDS=10
# REVY_TRAFEGO_CHATBOT_TOKENS_JSON={"moto-center":"..."}
# REVY_TRAFEGO_ESTOQUE_TOKENS_JSON={"moto-center":"..."}
# REVY_TRAFEGO_MOTOR_TOKENS_JSON={"moto-center":"..."}
# PORTAL_SERVICE_TOKEN=
# PORTAL_API_URL=http://127.0.0.1:9000
# CATALOGO_SERVICE_TOKEN=
# CATALOGO_PUBLIC_URL=http://127.0.0.1:8003
# ESTOQUE_API_URL=http://127.0.0.1:8002
# MOTOR_URL=http://127.0.0.1:8004
# Retry automático do outbox CAPI (defaults abaixo).
# PORTAL_CAPI_RETRY_ENABLED=1
# PORTAL_CAPI_RETRY_INTERVAL_SECONDS=60
# PORTAL_CAPI_RETRY_INITIAL_DELAY_SECONDS=30
# PORTAL_CAPI_RETRY_MAX_ATTEMPTS=8
# PORTAL_CAPI_RETRY_BACKOFF_BASE_SECONDS=60

# Tokens entre serviços
CHATBOT_WEBHOOK_TOKEN=
CHATBOT_API_TOKEN=
# Modo 2 (workflow cloud): credencial de INTEGRACAO, sem loja -- a loja de cada
# pedido vem da instance (spec 6.2). NAO reusar CHATBOT_API_TOKEN aqui: ele aponta
# para uma loja so. Criar com: python -m app.cli criar-credencial-integracao
CHATBOT_API_TOKEN_CLOUD=
# Obrigatório no Revy multi-loja: JSON loja_slug -> token do Chatbot.
# REVY_TRAFEGO_CHATBOT_TOKENS_JSON={"moto-center":"..."}
# Opcional no bundle app2037: se vazio, o Catálogo reutiliza CHATBOT_API_TOKEN.
# Em deploy separado, prefira uma credencial tenant-scoped exclusiva.
CATALOGO_EVENTS_TOKEN=
# Opcional: slug equivalente no Portal quando difere do slug público do Catálogo.
CATALOGO_PORTAL_STORE_SLUG=
ESTOQUE_API_TOKEN=
ESTOQUE_PUBLIC_API_TOKEN=
ESTOQUE_OUTBOX_KEY=
MOTOR_TOKEN=
MOTOR_METRICS_TOKEN=
MOTOR_ENCRYPTION_KEY=

# Evolution (VM canal)
CHATBOT_AUDIO_EVOLUTION_API_KEY=
CHATBOT_IMAGE_EVOLUTION_API_KEY=
# URL já default no fly.app.toml: http://evolution2037.flycast:8080

# n8n
N8N_ENCRYPTION_KEY=
# Gemini fica DENTRO do n8n (UI), não como secret Fly

# --- Fan-out Playwright (motor-api em app2037 → Machines API em motor2037) ---
# Obrigatório no app2037 para acordar workers on-demand.
MOTOR_FANOUT_ENABLED=1
MOTOR_FLY_AUTOSCALE_ENABLED=1
FLY_APP_NAME=motor2037
# Token app-scoped com permissão de start/stop no app motor2037 (não token pessoal).
FLY_API_TOKEN=
# Opcional (defaults no código / fly.app.toml):
# MOTOR_MAX_BROWSER_WORKERS=2
# MOTOR_FLY_START_BURST=2
# MOTOR_WORKER_IDLE_STOP_SECONDS=60
# MOTOR_WORKER_REWAKE_SECONDS=90

# Evolution app secrets (evolution2037)
# DATABASE_CONNECTION_URI=postgresql://...@suite-pg.flycast:5432/evolution
# AUTHENTICATION_API_KEY=
# CACHE_REDIS_URI=

# =============================================================================
# motor2037 — workers Playwright only (fly.worker.toml)
# fly secrets set ... -a motor2037
# =============================================================================
# DATABASE_URL = mesmo DB motor que MOTOR_DATABASE_URL no app2037
# DATABASE_URL=postgresql://USER:PASS@suite-pg.flycast:5432/motor
# MOTOR_ENCRYPTION_KEY=   # mesmo valor do app2037
# MOTOR_METRICS_TOKEN=    # opcional
#
# NÃO colocar FLY_API_TOKEN no worker (orquestrador é o app2037).
# MOTOR_WORKER_PROVEDOR é por Machine (slot), não secret global do app.
# Demais flags de browser/on-demand vêm de deploy/fly/3vm/fly.worker.toml [env].
