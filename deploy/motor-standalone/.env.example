# Copie para .env e preencha antes de subir.

# Chave de cifra dos dados pessoais (obrigatória; MOTOR_ENV=production exige).
# Gere uma com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MOTOR_ENCRYPTION_KEY=troque-por-uma-chave-fernet-valida

# Senha do Postgres (opcional; default "motor" para dev).
POSTGRES_PASSWORD=motor

# Intervalo (segundos) entre rodadas do worker que processa a fila de jobs.
MOTOR_WORKER_INTERVALO=2

# Lease do job (segundos). Após expirar, outro worker pode retomar o processamento.
MOTOR_JOB_LEASE_SECONDS=120

# Token Bearer dedicado para proteger /metrics. Gere um valor aleatório longo.
# Se vazio, /metrics fica sem autenticação e deve permanecer restrito pela rede.
MOTOR_METRICS_TOKEN=troque-por-um-token-aleatorio
